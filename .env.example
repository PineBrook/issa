# Environment variables
GEMINI_API_KEY=
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Neon Auth endpoint and a stable 32+ character cookie-signing secret.
# Enable Magic Link as the only provider in the Neon Auth console; disable password and social providers.
NEON_AUTH_BASE_URL=https://your-auth-endpoint.neonauth.aws.neon.tech
NEON_AUTH_COOKIE_SECRET=
